type Query {
    users: UsersResult
    userQuery(userId: ID!): UserResult
}

type User @key(fields: "userId") {
  userId: ID!
  name: String
  email: String
}

# Union types for error handling
union UserResult = User | UserNotFoundError | UserError
union UsersResult = UsersPayload | UserError

# Success payload for list of users
type UsersPayload {
    users: [User]!
}

# Error types
type UserNotFoundError {
    message: String!
    userId: ID!
}

type UserError {
    message: String!
    errorCode: String
}

